# This is an example .env file for the Daily Briefing project. Copy this file to .env and fill in your own values.
GEMINI_API_KEY= # Google AI Studio API key (free): https://aistudio.google.com/apikey
GMAIL_ADDRESS=# Gmail address to send from
GMAIL_APP_PASSWORD=# Gmail App Password (NOT your regular password) Generate at: https://myaccount.google.com/apppasswords