# Store real credentials in ignored .env or GitHub Actions secrets. Rotate any exposed credentials.
GEMINI_API_KEY=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=
# X requires independent API access, credits/entitlement and source queries in config/sources.json.
X_BEARER_TOKEN=
# Current official API naming; use tweet only if your account uses the legacy fields.
X_API_SCHEMA=post
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=
TIMEZONE=Asia/Jakarta
LANGUAGE=English
WINDOW_HOURS=24
IMPORTANCE_THRESHOLD=70
ENRICHMENT=true
HTTP_REQUESTS=400
HTTP_TIMEOUT=15
SOURCE_PAGES=10
AI_REQUESTS=120
AI_TOKENS=400000
AI_SECONDS=1200
AI_BATCH_SIZE=6
EVIDENCE_CHARS=10000
HTML_BYTES=81920
