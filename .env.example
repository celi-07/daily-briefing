# Store real credentials in ignored .env or GitHub Actions secrets. Rotate any exposed credentials.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FALLBACK_MODEL=
OPENAI_REASONING_EFFORT=none
# Gemini is used when OpenAI is missing or exhausted; AI_PROVIDER=gemini selects it directly.
GEMINI_API_KEY=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=
# X requires independent API access, credits/entitlement and source queries in config/sources.json.
X_BEARER_TOKEN=
# Current official API naming; use tweet only if your account uses the legacy fields.
X_API_SCHEMA=post
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
TIMEZONE=Asia/Jakarta
LANGUAGE=English
WINDOW_HOURS=24
IMPORTANCE_THRESHOLD=70
ENRICHMENT=true
HTTP_REQUESTS=400
HTTP_TIMEOUT=15
SOURCE_PAGES=10
AI_REQUESTS=120
AI_TOKENS=400000
AI_SECONDS=1200
AI_BATCH_SIZE=6
# Assessment uses at most this share, leaving room for summaries and audits.
AI_ASSESSMENT_FRACTION=0.8
# Short evidence for importance screening; summaries and audits use EVIDENCE_CHARS.
ASSESSMENT_EVIDENCE_CHARS=3000
EVIDENCE_CHARS=10000
HTML_BYTES=81920
