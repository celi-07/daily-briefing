<!doctype html>
<html lang="{{ language_code }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark">
<title>Morning Briefing · {{ digest.edition_date }}</title>
<style>
@media screen and (min-width: 600px) { .content { padding-left:28px !important; padding-right:28px !important; } }
@media (prefers-color-scheme: dark) {
  .page { background-color:#111827 !important; } .surface { background-color:#1e293b !important; }
  .ink { color:#f1f5f9 !important; } .muted { color:#cbd5e1 !important; }
  .link { color:#93c5fd !important; } .tint { background-color:#28364d !important; }
}
</style>
</head>
<body class="page" style="margin:0;padding:0;background-color:#f0f3f8;font-family:Arial,Helvetica,sans-serif;color:#17243c;">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">
{{ stories|length }} stories in this part · evidence-backed news, markets and analysis.
</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;">
<tr><td align="center" style="padding:20px 0;">
<!--[if mso]><table role="presentation" width="640" cellpadding="0" cellspacing="0"><tr><td><![endif]-->
<table role="presentation" class="surface" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:640px;background-color:#ffffff;table-layout:fixed;">
<tr><td class="content" style="padding:28px 16px 24px;border-top:4px solid #2563eb;">
<p style="margin:0 0 12px;font-size:12px;font-weight:bold;letter-spacing:2px;color:#2563eb;">THE MORNING BRIEFING</p>
<h1 class="ink" style="margin:0 0 12px;font-size:30px;line-height:1.2;color:#17243c;">A clearer start to your day.</h1>
<p class="muted" style="margin:0;font-size:14px;line-height:1.6;color:#526176;">{{ digest.edition_date }} · {{ digest.timezone }}{% if total > 1 %} · Part {{ index }}/{{ total }}{% endif %}</p>
<p class="muted" style="margin:8px 0 0;font-size:12px;line-height:1.6;color:#526176;">News window: {{ digest.window_start|localtime }} – {{ digest.window_end|localtime }}</p>
<p class="muted" style="margin:8px 0 0;font-size:12px;line-height:1.6;color:#526176;">{{ ai_coverage.verified_stories }} evidence-checked stories.</p>
</td></tr>
{% if index == 1 and takeaways %}
<tr><td class="content" style="padding:0 16px 24px;">
<table role="presentation" class="tint" width="100%" cellpadding="0" cellspacing="0" style="background-color:#eef4ff;table-layout:fixed;">
<tr><td style="padding:20px 16px;">
<h2 class="ink" style="margin:0 0 12px;font-size:20px;line-height:1.4;color:#17243c;">At a glance</h2>
{% for story in takeaways %}<p class="ink" style="margin:0 0 12px;font-size:16px;line-height:1.6;color:#17243c;">{{ loop.index }}. {{ story.headline }} <span class="muted" style="font-size:12px;color:#526176;">({{ labels[story.topic] }})</span></p>{% endfor %}
</td></tr></table></td></tr>
{% endif %}
{% if index == 1 and digest.quotes %}
<tr><td class="content" style="padding:0 16px 24px;">
<h2 class="ink" style="margin:0 0 8px;font-size:22px;line-height:1.4;color:#17243c;">Market snapshot</h2>
<p class="muted" style="margin:0 0 12px;font-size:12px;line-height:1.6;color:#526176;">Latest available daily observations, compared with the previous available daily close.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="table-layout:fixed;">
{% for q in digest.quotes %}
<tr><td class="ink" style="padding:12px 0;border-bottom:1px solid #dce3ee;font-size:16px;line-height:1.6;color:#17243c;">
<strong>{{ q.label }}</strong><br>
{% if q.unavailable %}<span class="muted" style="font-size:14px;color:#526176;">Data unavailable</span>
{% else %}{{ "{:,.2f}".format(q.price) }} <span class="muted" style="font-size:12px;color:#526176;">{{ q.unit }}</span> · {% if q.change_pct is not none %}{{ "{:+.2f}%".format(q.change_pct) }}{% else %}Change unavailable{% endif %}
<br><span class="muted" style="font-size:12px;color:#526176;">Daily-bar session date {{ q.session_date }}{% if q.stale %} · Older observation / market may be closed{% endif %}</span>{% endif %}
</td></tr>{% endfor %}
</table></td></tr>{% endif %}
{% for topic in topics %}
{% set section = stories|selectattr('briefing_section', 'equalto', topic)|list %}
{% if section or total == 1 %}
<tr><td class="content" style="padding:0 16px 24px;">
<h2 class="ink" style="margin:0 0 16px;padding-top:16px;border-top:2px solid #dce3ee;font-size:22px;line-height:1.4;color:#17243c;">{{ section_labels[topic] }} <span class="muted" style="font-size:14px;font-weight:normal;color:#526176;">{{ section|length }} {% if total > 1 %}in this part · {{ counts[topic] }} total{% else %}stories{% endif %}{% if topic in continued %} · continued{% endif %}</span></h2>
{% if not section %}<p class="muted" style="font-size:16px;line-height:1.6;color:#526176;">{{ empty_states[topic] }}</p>{% endif %}
{% for story in section %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="table-layout:fixed;"><tr><td style="padding:0 0 24px;" data-event-id="{{ story.event_id }}">
<p class="muted" style="margin:0 0 8px;font-size:12px;line-height:1.6;color:#526176;">{{ story.published_at|localtime }} · {% if story.world_score is none and story.market_score is none and story.importance is not none %}Importance {{ story.importance|int }}/100 · {% endif %}{{ status_labels[story.status] }}{% for t in story.secondary_topics if t != story.topic %} · {{ labels[t] }}{% endfor %}</p>
<h3 class="ink" style="margin:0 0 12px;font-size:20px;line-height:1.4;color:#17243c;overflow-wrap:anywhere;word-break:break-word;">{{ story.headline }}</h3>
<p class="ink" style="margin:0 0 12px;font-size:16px;line-height:1.6;color:#17243c;overflow-wrap:anywhere;word-break:break-word;">{{ story.summary }}</p>
{% if story.why_it_matters %}<p class="ink" style="margin:0 0 12px;font-size:16px;line-height:1.6;color:#17243c;"><strong>Why it matters:</strong> {{ story.why_it_matters }}</p>{% endif %}
<p class="muted" style="margin:0 0 12px;font-size:12px;line-height:1.6;color:#526176;">{{ labels[story.topic] }}{% for region in story.regions %} · {{ region }}{% endfor %}{% for theme in story.themes %} · {{ theme }}{% endfor %}{% if story.world_score is not none %} · World significance {{ story.world_score }}/5{% endif %}{% if story.market_score is not none %} · Market relevance {{ story.market_score }}/5{% endif %}<br>{% if story.reporting_basis == 'primary-statement' %}Organization's own statement; announced benefits remain claims.{% elif story.reporting_basis == 'corroborated' %}Multiple independent reports in the collected evidence.{% else %}Reported by {% for citation in story.citations %}{{ citation.source }}{% if not loop.last %}, {% endif %}{% endfor %}; summary checked against the reporting.{% endif %}</p>
{% if story.market_context %}
<p class="ink" style="margin:0 0 12px;font-size:14px;line-height:1.6;color:#17243c;"><strong>Market context</strong><br>
{% if story.market_context.affected %}<strong>Exposure:</strong> {% for claim in story.market_context.affected %}{{ claim.text }}{% if not loop.last %}; {% endif %}{% endfor %}<br>{% endif %}
<strong>Possible implications:</strong> {{ story.market_context.mechanism }}<br>
<strong>Timing:</strong> {{ story.market_context.timing }}<br>
{% if story.market_context.watch %}<strong>Watch:</strong> {% for claim in story.market_context.watch %}{{ claim.text }}{% if not loop.last %}; {% endif %}{% endfor %}<br>{% endif %}
<strong>Uncertainty:</strong> {{ story.market_context.uncertainty }}<br>
<span class="muted" style="color:#526176;">Whether this is already reflected in market prices has not been assessed.</span></p>
{% endif %}
{% if story.caveat %}<p class="muted" style="margin:0 0 12px;font-size:12px;line-height:1.6;color:#526176;">{{ story.caveat }}</p>{% endif %}
<p style="margin:0;font-size:14px;line-height:2;overflow-wrap:anywhere;word-break:break-word;">{% for citation in story.citations %}<a class="link" href="{{ citation.url }}" style="color:#1d4ed8;text-decoration:underline;padding:10px 0;">Read {{ citation.source }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
</td></tr></table>{% endfor %}
</td></tr>{% endif %}{% endfor %}
<tr><td class="content tint" style="padding:24px 16px;background-color:#f6f8fc;border-top:1px solid #dce3ee;">
{% if show_notes and digest.notes %}
{% for kind, heading in [('connection', 'Connecting the dots'), ('watch', 'What to watch')] %}
{% set notes = digest.notes|selectattr('kind', 'equalto', kind)|list %}
{% if notes %}<h2 class="ink" style="margin:0 0 12px;font-size:20px;color:#17243c;">{{ heading }}</h2>
{% for note in notes %}<p class="ink" style="margin:0 0 12px;font-size:16px;line-height:1.6;color:#17243c;">{{ note.text }}<br>
{% for sid in note.story_ids if sid in note_sources %}<a class="link" href="{{ note_sources[sid].url }}" style="font-size:12px;color:#1d4ed8;text-decoration:underline;">{{ note_sources[sid].source }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endfor %}
{% endif %}{% endfor %}{% endif %}
<h2 class="ink" style="margin:0 0 12px;font-size:18px;color:#17243c;">Coverage &amp; sources</h2>
{% for notice in digest.notices %}<p class="muted" style="margin:0 0 8px;font-size:12px;line-height:1.6;color:#526176;">{{ notice }}</p>{% endfor %}
{% for source in digest.health if source.status != 'ok' %}<p class="muted" style="margin:0 0 8px;font-size:12px;line-height:1.6;color:#526176;"><strong>{{ source.name }}:</strong> {{ source.status }}. {{ source.detail }}</p>{% endfor %}
<p class="muted" style="margin:12px 0 0;font-size:12px;line-height:1.6;color:#526176;">Only stories with evidence-checked AI analysis are shown. Scores are editorial judgments. Evidence checks verify the summary against its sources, not the underlying event independently. Automated briefing · AI analysis &amp; publisher sources · {{ digest.pipeline_version }}.</p>
{% if total > 1 %}<p class="muted" style="margin:8px 0 0;font-size:12px;line-height:1.6;color:#526176;">This is part {{ index }} of {{ total }}. Read all numbered emails for the full briefing.</p>{% endif %}
</td></tr></table>
<!--[if mso]></td></tr></table><![endif]-->
</td></tr></table></body></html>
